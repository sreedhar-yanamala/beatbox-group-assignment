    {
      "name": "⭐ Twist Rule Tests (Required in Brief)",
      "item": [
        {
          "name": "Test 1: Add with family 'String' -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Instrument family is String', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.family).to.eql('String');",
                  "    pm.expect(json.name).to.eql('Cello Allegro');",
                  "    pm.collectionVariables.set('twistInstrumentId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cello Allegro\",\n  \"family\": \"String\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/instruments",
              "host": ["{{baseUrl}}"],
              "path": ["instruments"]
            },
            "description": "Brief Test 1: Add with family 'String' -> 201"
          }
        },
        {
          "name": "Test 2: Add with family 'Other' -> 400, allowed values shown",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 400 Bad Request', function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test('Error message lists allowed values: String, Percussion, Wind', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.error).to.include('String');",
                  "    pm.expect(json.error).to.include('Percussion');",
                  "    pm.expect(json.error).to.include('Wind');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
